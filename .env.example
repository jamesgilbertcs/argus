# Copy required values to .env.local, or set them in the process environment.
# Never put real credentials in this example file.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=<your-api-key>

# Optional client limits.
ZETARIS_TIMEOUT_SECONDS=30
ZETARIS_QUERY_LIMIT=1000
ZETARIS_MAX_RESPONSE_BYTES=8388608

# Only needed to fetch the OpenAPI specification with Basic authentication.
# The REST query client does not use these settings.
# ZETARIS_USERNAME=<your-username>
# ZETARIS_PASSWORD=<your-password>

# Optional Phase 3B provider. Used only with explicit --provider openai.
# The compact evidence view will be sent to api.openai.com over HTTPS.
# Choose a model supporting the Responses API and strict Structured Outputs.
# OPENAI_API_KEY=<your-openai-api-key>
# ARGUS_OPENAI_MODEL=<your-supported-model-id>

# Optional Phase 3B.1 provider. Used only with explicit --provider meterless.
# Uses the existing Nightshift token; no OpenAI or NVIDIA key is needed by ARGUS.
# Requires strict json_schema support; ARGUS never downgrades to prompt-only JSON.
# METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# METERLESS_RUNTIME_TOKEN=<your-existing-runtime-token>
# METERLESS_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Shared inference limits. Default timeout: OpenAI 60s, Meterless 180s.
# ARGUS_INFERENCE_TIMEOUT_SECONDS=60
# ARGUS_MAX_OUTPUT_TOKENS=6000
