# Copy required values to .env.local, or set them in the process environment.
# Never put real credentials in this example file.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=<your-api-key>

# Optional client limits.
ZETARIS_TIMEOUT_SECONDS=30
ZETARIS_QUERY_LIMIT=1000
ZETARIS_MAX_RESPONSE_BYTES=8388608

# Only needed to fetch the OpenAPI specification with Basic authentication.
# The REST query client does not use these settings.
# ZETARIS_USERNAME=<your-username>
# ZETARIS_PASSWORD=<your-password>
